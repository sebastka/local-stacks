---
apiVersion: v1
kind: Config
current-context: my-k8s-cluster
preferences: {}

clusters:
  - name: my-k8s-cluster
    cluster:
      server: https://my-k8s-cluster-api-server.example.com
      certificate-authority-data: XXX

contexts:
  - name: my-k8s-cluster
    context:
      cluster: my-k8s-cluster
      user: my-k8s-cluster-admin

users:
  - name: my-k8s-cluster-admin
    user: {}

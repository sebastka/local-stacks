UID=1000
GID=1000

MAINAPPPORT=8900

# Kubernetes connectivity - set to false when running outside the cluster
KUBERNETES__USEDEFAULTCONTEXT=false
# Full path inside the container where the kubeconfig is mounted
KUBERNETES__KUBECONFIGFILENAME=/kubeconfig/config
# Comma-delimited namespace list; empty = all namespaces
KUBERNETES__NAMESPACELIST=

# Trivy report types to enable
KUBERNETES__TRIVYUSECLUSTERCOMPLIANCEREPORT=true
KUBERNETES__TRIVYUSECLUSTERINFRAASSESSMENTREPORT=true
KUBERNETES__TRIVYUSECLUSTERRBACASSESSMENTREPORT=true
KUBERNETES__TRIVYUSECLUSTERSBOMREPORT=true
KUBERNETES__TRIVYUSECLUSTERVULNERABILITYREPORT=true
KUBERNETES__TRIVYUSECONFIGAUDITREPORT=true
KUBERNETES__TRIVYUSEINFRAASSESSMENTREPORT=true
KUBERNETES__TRIVYUSEEXPOSEDSECRETREPORT=true
KUBERNETES__TRIVYUSERBACASSESSMENTREPORT=true
KUBERNETES__TRIVYUSESBOMREPORT=true
KUBERNETES__TRIVYUSEVULNERABILITYREPORT=true

# File repository (PVC-backed) - disabled for local use
FILEREPOSITORY__BASEPATH=

# GitHub update checks
GITHUB__SERVERCHECKFORUPDATES=true
GITHUB__CHECKFORUPDATESINTERVALINMINUTES=360

# OpenTelemetry - disabled by default
OPENTELEMETRY__ENABLED=false
OPENTELEMETRY__OTELENDPOINT=
OPENTELEMETRY__OTELPROTOCOL=grpc
OPENTELEMETRY__CONSOLEENABLED=false
OPENTELEMETRY__ASPNETCOREINSTRUMENTATIONENABLED=true
OPENTELEMETRY__RUNTIMEINSTRUMENTATIONENABLED=true
OPENTELEMETRY__PROMETHEUSEXPORTERPORT=

# Logging
SERILOG__MINIMUMLEVEL__DEFAULT=Information

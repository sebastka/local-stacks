# Settings for bin/gen-configs and bin/forward, which read .env themselves.
# Copy to .env and uncomment what you need. What is set here wins over the
# environment, so a KUBECONFIG here beats the one your shell exports.

# The kubeconfig everything is generated from, if not the one in your shell.
# KUBECONFIG=$HOME/.kube/config

# Contexts to include, space separated. Default: every context whose user does
# not exec an OIDC plugin (their tokens are too short-lived for containers).
# KUBE_CONTEXTS="my-cluster other-cluster"

# current-context of the generated kubeconfig, i.e. the cluster single-cluster
# stacks talk to. Default: your kubeconfig's, if included, else the first one.
# KUBE_CONTEXT=my-cluster

# How containers reach a database directly, if they can. Placeholders: {svc},
# {ns}, {cluster} (the context name without user@, k8s- and -cluster), {context}.
# Names that do not resolve fall back to bin/forward.
# DB_HOST_TEMPLATE={svc}.{cluster}.example.org

# Where bin/forward listens, and the name containers use to reach it.
# CONTAINER_HOST_ADDRESS=127.0.0.1
# FORWARD_HOST=host.docker.internal

# Logins. A password left empty is generated and saved here on the next run.
# pgAdmin only takes its email and password when it first creates its config
# DB: to change them later, also `docker compose down` pgadmin.
# KITE_USERNAME=admin
# KITE_PASSWORD=
# PGADMIN_EMAIL=me@domain.tld
# PGADMIN_PASSWORD=
# PGADMIN_GROUP=Kubernetes
# ch-ui has no login of its own: it asks for the ClickHouse server's users.
# Its session and credential encryption key, generated if empty:
# CHUI_APP_SECRET_KEY=

# The bin/*-ui dashboards. Their cluster: a context given as argument, else
# DASHBOARD_CONTEXT, else your kubeconfig's current context.
# DASHBOARD_CONTEXT=my-cluster
# ARGOCD_CONTEXT=my-cluster          # bin/argocd-ui only, over DASHBOARD_CONTEXT
# ARGOCD_NAMESPACE=argocd
# ARGOCD_PORT=8086
# ENVOY_GATEWAY_NAMESPACE=envoy-gateway-system
# ENVOY_GATEWAY_UI_PORT=8087
# CILIUM_NAMESPACE=kube-system
# HUBBLE_UI_PORT=8088
# SVC_UI_PORT=8089
# VICTORIA_LOGS_UI_PORT=8090
# VICTORIA_METRICS_UI_PORT=8091
# VMALERT_UI_PORT=8092
# ALERTMANAGER_UI_PORT=8093
# LONGHORN_UI_PORT=8094

# bin/cscli: where CrowdSec's LAPI runs.
# CROWDSEC_CONTEXT=my-cluster       # else DASHBOARD_CONTEXT
# CROWDSEC_NAMESPACE=crowdsec

#!/usr/bin/env bash
#
# Argo CD's UI, run here rather than in the cluster: `argocd admin dashboard`
# serves the API server and UI locally, reaching the in-cluster repo-server
# and Redis through the Kubernetes API, as your kubeconfig user. No Argo CD
# login or RBAC: you can do what that user can.
#
# It runs on the host, not in a container, so that your kubeconfig's exec
# plugins (OIDC, doctl) keep refreshing its credentials.
#
# Usage: bin/argocd-ui [argocd admin dashboard flags...]
#
# Settings (.env, see .env.dist): ARGOCD_CONTEXT (else DASHBOARD_CONTEXT),
# ARGOCD_NAMESPACE, ARGOCD_PORT.

# shellcheck source=lib/dashboard.sh
. "$(dirname "$(readlink -f "$0")")/lib/dashboard.sh"

context=$(dashboard_context "${ARGOCD_CONTEXT:-}")
namespace=${ARGOCD_NAMESPACE:-argocd}
port=${ARGOCD_PORT:-8086}

echo "Argo CD in $context/$namespace: http://localhost:$port/"
exec argocd admin dashboard --context "$context" -n "$namespace" \
    --address 127.0.0.1 --port "$port" "$@"

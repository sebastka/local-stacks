#!/usr/bin/env bash
#
# Generate every cluster-derived config in this repo from one input: your
# kubeconfig, as kubectl finds it ($KUBECONFIG, else ~/.kube/config). Nothing
# here is tied to a provider or a cluster -- point KUBECONFIG elsewhere and
# re-run.
#
#   kube     .kubeconfig.gen.yaml, a kubeconfig containers can use, mounted
#            by every stack that needs one
#   kite     kite/.persist/kite-config.yaml, one entry per context
#   pgadmin  pgadmin/.persist/{servers.json,pgpass}, one server per postgres
#   pma      pma/.env, every mariadb/mysql in one phpMyAdmin
#   chui     ch-ui/.env.<cluster>.<service>, one per clickhouse
#   init     copy every *.dist to its real name, unless that already exists
#
# Containers cannot run kubeconfig exec plugins (doctl, kubelogin, ...), so each
# plugin is run here and its credential baked in. That credential expires when
# the plugin says it does -- re-run to renew. OIDC contexts are skipped by
# default: their tokens tend to last minutes, not days.
#
# Databases are found by looking for running pods whose image is mariadb,
# mysql, postgres or clickhouse, then the Service in front of them. The
# credentials are read from the pod's own env (value, secretKeyRef, envFrom).
# How the containers reach a database:
#   - DB_HOST_TEMPLATE, when set and the name it gives resolves, e.g.
#     '{svc}.{cluster}.example.org' (also: {ns}, {context});
#   - otherwise FORWARD_HOST:<local port>, served by bin/forward, which
#     port-forwards each of them on CONTAINER_HOST_ADDRESS.
#
# Usage: bin/gen-configs [--restart] [--no-refresh] [section...]
#
#   section       kube, kite, pgadmin, pma, chui, init (default: all of them)
#   --restart     recreate the stacks a generated section feeds, skipping any
#                 that are not currently running
#   --no-refresh  keep doctl's cached credentials instead of issuing new ones
#
# Settings: .env at the repo root, over the environment -- see .env.dist.

set -euo pipefail

cd "$(dirname "$(readlink -f "$0")")/.."

# Settings from .env, over the environment: your shell may well export a
# KUBECONFIG of its own, and this repo's is the one that counts here.
if [[ -f .env ]]; then
    set -a
    # shellcheck source=/dev/null
    . ./.env
    set +a
fi

MARKER="# Generated by bin/gen-configs"
SECTIONS=(kube kite pgadmin pma chui init)

GEN_KUBECONFIG=.kubeconfig.gen.yaml
FORWARDS=.forwards.tsv
KITE_TEMPLATE=bin/templates/kite-config.yaml
KITE_CONFIG=kite/.persist/kite-config.yaml
PGADMIN_DIR=pgadmin/.persist

# Directories a stack mounts that no .dist provides, and writes to.
PERSIST_DIRS=(kite/.persist/data policy-reporter/.persist/sqlite radar/.persist)

# The stacks run as a non-root uid with gid 0, which rootless Docker maps to
# your own group: what they read is group readable (640), what they write
# group writable (770), and nothing is world readable.

# Selected contexts, filled in by load_contexts, in kubeconfig order.
CTX=() CTX_CLUSTER=()
# Context -> single-context kubeconfig with its credential resolved.
declare -A CTX_KUBECONFIG

# One entry per database, filled in by discover_databases.
DB_KIND=() DB_CTX=() DB_SHORT=() DB_NS=() DB_SVC=()
DB_HOST=() DB_PORT=() DB_USER=() DB_PASS=()

WORK=""

main()
{
    local restart=0 wanted=() section

    while (( $# )); do
        case $1 in
            --restart)    restart=1 ;;
            --no-refresh) REFRESH=0 ;;
            -h|--help)    usage; exit 0 ;;
            -*)           usage >&2; exit 2 ;;
            *)            has_section "$1" "${SECTIONS[@]}" || { usage >&2; exit 2; }
                          wanted+=("$1") ;;
        esac
        shift
    done
    (( ${#wanted[@]} )) || wanted=("${SECTIONS[@]}")

    load_settings
    require_bins

    WORK=$(mktemp -d)
    trap 'rm -rf -- "$WORK"' EXIT

    if has_section kube "${wanted[@]}" || has_section kite "${wanted[@]}" ||
       has_section pgadmin "${wanted[@]}" || has_section pma "${wanted[@]}" ||
       has_section chui "${wanted[@]}"; then
        load_contexts
    fi
    if has_section kube "${wanted[@]}" || has_section kite "${wanted[@]}"; then
        resolve_kubeconfigs
    fi
    if has_section pgadmin "${wanted[@]}" || has_section pma "${wanted[@]}" ||
       has_section chui "${wanted[@]}"; then
        discover_databases
    fi

    # Always in this order: init only fills in what the others did not write.
    for section in "${SECTIONS[@]}"; do
        has_section "$section" "${wanted[@]}" || continue
        echo
        "gen_${section}"
    done

    echo
    if (( restart )); then
        restart_stacks "${wanted[@]}"
    else
        echo "Generated configs are read at startup -- restart to pick them up:"
        echo "  bin/gen-configs ${wanted[*]} --restart"
    fi
    if [[ -s $FORWARDS ]]; then
        echo "Some databases are only reachable through bin/forward -- keep it running."
    fi
}

usage()
{
    local IFS='|'
    echo "usage: bin/gen-configs [--restart] [--no-refresh] [${SECTIONS[*]} ...]"
}

die() { echo "error: $*" >&2; exit 1; }
warn() { echo "  warning: $*" >&2; }

# has_section <needle> <item>...
has_section()
{
    local needle=$1 s
    shift
    for s in "$@"; do
        [[ $s == "$needle" ]] && return 0
    done
    return 1
}

load_settings()
{
    SOURCE=${KUBECONFIG:-~/.kube/config}
    KUBE_CONTEXTS=${KUBE_CONTEXTS:-}
    KUBE_CONTEXT=${KUBE_CONTEXT:-}
    DB_HOST_TEMPLATE=${DB_HOST_TEMPLATE:-}
    FORWARD_HOST=${FORWARD_HOST:-host.docker.internal}
    PGADMIN_GROUP=${PGADMIN_GROUP:-Kubernetes}
    PGADMIN_EMAIL=${PGADMIN_EMAIL:-me@domain.tld}
    PGADMIN_PASSWORD=${PGADMIN_PASSWORD:-}
    KITE_USERNAME=${KITE_USERNAME:-admin}
    KITE_PASSWORD=${KITE_PASSWORD:-}
    DOCTL_CACHE=${DOCTL_CACHE:-$HOME/.config/doctl/cache/exec-credential}
    REFRESH=${REFRESH:-1}
}

require_bins()
{
    local bin
    for bin in kubectl jq yq getent base64; do
        command -v "$bin" >/dev/null || die "$bin not found in PATH"
    done
    yq --version | grep -q mikefarah || die "yq must be mikefarah/yq v4"
}

# kc <context> <kubectl args>... -- kubectl as you, with your own credentials
kc() { kubectl --context "$1" "${@:2}"; }

# Write stdin to <path>, replacing whatever is there. rm first: the target may
# be a link into a hand-maintained config, which a redirect would write through.
# write_out <path> <mode>
write_out()
{
    mkdir -p "$(dirname "$1")"
    rm -f -- "$1"
    cat >"$1"
    chmod "$2" "$1"
    echo "  wrote $1"
}

random_secret() { head -c 32 /dev/urandom | base64 | tr -d '/+=\n'; }

# A template's leading comment block documents the template itself, so it is
# dropped; comments further down are the author's and are rendered as-is.
strip_header() { awk 'body || !/^#/ { body = 1; print }' "$1"; }

# k8s-web-cluster -> web, topf@talmox -> talmox: the cluster's name in
# generated file names and labels.
short_name()
{
    local n=${1#*@}
    n=${n#k8s-}
    n=${n%-cluster}
    printf '%s' "${n//[^A-Za-z0-9_.-]/-}"
}

# KUBE_CONTEXTS, or every context whose user does not exec an OIDC plugin.
load_contexts()
{
    local all ctx cluster oidc
    all=$(kubectl config view -o json) || die "cannot read $SOURCE"

    if [[ -n $KUBE_CONTEXTS ]]; then
        for ctx in $KUBE_CONTEXTS; do
            cluster=$(jq -er --arg c "$ctx" \
                '.contexts[] | select(.name == $c) | .context.cluster' <<<"$all") ||
                die "context $ctx (KUBE_CONTEXTS) is not in $SOURCE"
            CTX+=("$ctx")
            CTX_CLUSTER+=("$cluster")
        done
    else
        while IFS=$'\t' read -r ctx cluster oidc; do
            if [[ $oidc == true ]]; then
                echo "  skipping context $ctx: OIDC, set KUBE_CONTEXTS to include it"
                continue
            fi
            CTX+=("$ctx")
            CTX_CLUSTER+=("$cluster")
        done < <(jq -r '
            (.users // []) as $users
            | .contexts[]
            | .context.user as $u
            | ([$users[] | select(.name == $u) | .user.exec // empty
                | ([.command] + (.args // [])) | join(" ") | test("oidc"; "i")]
               | any) as $oidc
            | [.name, .context.cluster, $oidc] | @tsv' <<<"$all")
    fi

    (( ${#CTX[@]} )) || die "no usable context in $SOURCE"
    echo "${#CTX[@]} context(s) from $SOURCE: ${CTX[*]}"
}

# One kubeconfig per context, flattened, with the user renamed after the
# context (several contexts may share a user name) and any exec plugin replaced
# by the credential it returns.
resolve_kubeconfigs()
{
    local i ctx out
    echo
    echo "Resolving credentials:"
    for i in "${!CTX[@]}"; do
        ctx=${CTX[i]}
        out=$WORK/ctx-$i.yaml
        kc "$ctx" config view --minify --flatten --raw |
            CTX=$ctx yq '.users[0].name = strenv(CTX) |
                         .contexts[0].context.user = strenv(CTX)' >"$out"

        if [[ $(yq '.users[0].user | has("exec")' "$out") == true ]]; then
            resolve_exec "$ctx" "$out"
        else
            echo "  $ctx: $(yq '.users[0].user | keys | join(", ")' "$out"), used as-is"
        fi
        CTX_KUBECONFIG[$ctx]=$out

        # An expired client certificate looks just as valid as a fresh one.
        if ! kubectl --kubeconfig "$out" get --raw /version --request-timeout=10s \
                >/dev/null 2>"$WORK/err"; then
            warn "$ctx: the cluster rejects this credential: $(tail -n1 "$WORK/err")"
        fi
    done
}

# Run the exec plugin of <file>'s only user and replace it by its result.
# resolve_exec <context> <file>
resolve_exec()
{
    local ctx=$1 file=$2 spec cmd api cred info args=() envs=()
    spec=$(yq -o json '.users[0].user.exec' "$file")
    cmd=$(jq -r '.command' <<<"$spec")
    api=$(jq -r '.apiVersion' <<<"$spec")
    mapfile -t args < <(jq -r '.args[]?' <<<"$spec")
    mapfile -t envs < <(jq -r '.env[]? | "\(.name)=\(.value)"' <<<"$spec")

    # doctl caches its token and hands back the same one until it expires,
    # possibly hours from now. Dropping the cache entry (named after the
    # cluster ID, its last argument) does not revoke that token, it just gets
    # a fresh seven-day one issued.
    if [[ $(basename "$cmd") == doctl ]] && (( REFRESH )) && (( ${#args[@]} )); then
        rm -f -- "$DOCTL_CACHE/${args[-1]}.json"
    fi

    info=$(jq -cn --arg api "$api" \
        '{apiVersion: $api, kind: "ExecCredential", spec: {interactive: false}}')
    cred=$(env KUBERNETES_EXEC_INFO="$info" "${envs[@]}" "$cmd" "${args[@]}" </dev/null) ||
        die "$ctx: exec plugin $cmd failed"

    jq -e '.status.token or .status.clientCertificateData' <<<"$cred" >/dev/null ||
        die "$ctx: exec plugin $cmd returned neither a token nor a client certificate"

    if jq -e '.status.token' <<<"$cred" >/dev/null; then
        TOKEN=$(jq -r '.status.token' <<<"$cred") \
            yq -i '.users[0].user = {"token": strenv(TOKEN)}' "$file"
    else
        CERT=$(jq -r '.status.clientCertificateData' <<<"$cred") \
        KEY=$(jq -r '.status.clientKeyData' <<<"$cred") \
            yq -i '.users[0].user = {
                "client-certificate-data": (strenv(CERT) | @base64),
                "client-key-data": (strenv(KEY) | @base64)}' "$file"
    fi

    echo "  $ctx: $(basename "$cmd") credential, expires" \
        "$(jq -r '.status.expirationTimestamp // "(not said)"' <<<"$cred")"
}

# Every context in one kubeconfig, which the stacks mount as ../GEN_KUBECONFIG.
gen_kube()
{
    echo "kube: merging ${#CTX[@]} context(s) into $GEN_KUBECONFIG"

    local current=$KUBE_CONTEXT files=() ctx merged
    if [[ -z $current ]]; then
        current=$(kubectl config current-context 2>/dev/null || true)
        has_section "$current" "${CTX[@]}" || current=${CTX[0]}
    fi
    has_section "$current" "${CTX[@]}" ||
        die "KUBE_CONTEXT=$current is not one of: ${CTX[*]}"

    for ctx in "${CTX[@]}"; do
        files+=("${CTX_KUBECONFIG[$ctx]}")
    done

    # --raw keeps the credentials: without it kubectl prints them as REDACTED.
    merged=$(KUBECONFIG=$(IFS=:; echo "${files[*]}") kubectl config view --flatten --raw |
        CUR=$current yq '.["current-context"] = strenv(CUR)')

    # A stack started before the first run makes Docker create the missing
    # file as an empty directory.
    if [[ -d $GEN_KUBECONFIG ]]; then
        rmdir -- "$GEN_KUBECONFIG" 2>/dev/null ||
            die "$GEN_KUBECONFIG is a non-empty directory, expected a kubeconfig"
    fi
    {
        echo "$MARKER from $SOURCE -- do not edit."
        printf '%s\n' "$merged"
    } | write_out "$GEN_KUBECONFIG" 640
    echo "  current-context: $current"
}

# kite keeps its clusters inline: each gets the single-context kubeconfig
# gen_kube merges, so the two cannot drift.
gen_kite()
{
    echo "kite: rendering $KITE_CONFIG"
    ensure_secrets kite/.persist/secrets.env JWT_SECRET KITE_ENCRYPT_KEY

    local i ctx file server out=$WORK/kite.yaml
    ensure_setting KITE_PASSWORD
    strip_header "$KITE_TEMPLATE" |
        USERNAME=$KITE_USERNAME PASSWORD=$KITE_PASSWORD \
        yq '.superUser.username = strenv(USERNAME) |
            .superUser.password = strenv(PASSWORD)' >"$out"

    for i in "${!CTX[@]}"; do
        ctx=${CTX[i]}
        file=${CTX_KUBECONFIG[$ctx]}
        server=$(yq '.clusters[0].cluster.server' "$file")
        NAME=$ctx DESC="$ctx ($server)" FILE=$file yq -i '
            .clusters += [{
              "name": strenv(NAME),
              "description": strenv(DESC),
              "config": load_str(strenv(FILE))
            }]
            | .clusters[-1].config style="literal"' "$out"
    done

    # Chmod rather than umask: it holds a credential per cluster.
    { echo "$MARKER from $KITE_TEMPLATE -- edit that instead."; cat "$out"; } |
        write_out "$KITE_CONFIG" 640
}

# Fill DB_* from every selected cluster. A cluster reached through several
# contexts is only looked at once.
discover_databases()
{
    local i ctx cluster seen=" " kind ns svc port pod ci
    declare -A next_port=([mysql]=13306 [postgres]=15432 [clickhouse]=18123)

    echo
    echo "Looking for databases:"
    : >"$WORK/forwards"
    for i in "${!CTX[@]}"; do
        ctx=${CTX[i]}
        cluster=${CTX_CLUSTER[i]}
        [[ $seen == *" $cluster "* ]] && continue
        seen+="$cluster "

        while IFS=$'\t' read -r kind ns svc port pod ci; do
            if [[ -z $svc ]]; then
                warn "$ctx: $kind pod $ns/$pod has no Service in front of it, skipped"
                continue
            fi
            DB_KIND+=("$kind")
            DB_CTX+=("$ctx")
            DB_SHORT+=("$(short_name "$ctx")")
            DB_NS+=("$ns")
            DB_SVC+=("$svc")
            db_endpoint "$port"
            db_credentials "$pod" "$ci"
            echo "  $ctx: $kind $ns/$svc -> ${DB_HOST[-1]}:${DB_PORT[-1]}"
        done < <(find_databases "$ctx")
    done

    if [[ -s $WORK/forwards ]]; then
        { echo "# context	namespace	service	local-port	remote-port	kind"
          cat "$WORK/forwards"; } | write_out "$FORWARDS" 600
    else
        rm -f -- "$FORWARDS"
    fi
    (( ${#DB_KIND[@]} )) || echo "  none found"
}

# One TSV line per database Service: kind, namespace, service, port, and one
# of its pods with the index of the database container. Pods run by Jobs
# (backups, migrations) only use a database, they are not one.
# find_databases <context>
find_databases()
{
    local pods
    pods=$(kc "$1" get pods -A --field-selector=status.phase=Running -o json) &&
        kc "$1" get services -A -o json >"$WORK/services.json" ||
        { warn "$1: cannot list pods and services, skipped"; return 0; }

    jq -r --slurpfile svcs "$WORK/services.json" '
        def kind_of:
            split("/") | last | split("@")[0] | split(":")[0]
            | if test("^(mariadb|mysql|percona-server)$") then "mysql"
              elif test("^(postgres|postgresql|postgis)$") then "postgres"
              elif test("^clickhouse(-server)?$") then "clickhouse"
              else empty end;
        def default_port: {mysql: 3306, postgres: 5432, clickhouse: 8123}[.];

        [ .items[]
          | select([.metadata.ownerReferences[]?.kind] | index("Job") | not)
          | . as $pod
          | .spec.containers | to_entries[]
          | .key as $ci
          | (.value.image | kind_of) as $kind
          | ($kind | default_port) as $dp
          | [ $svcs[0].items[]
              | select(.metadata.namespace == $pod.metadata.namespace)
              | select((.spec.selector // {}) | length > 0)
              | select(.spec.selector | to_entries
                       | all(.value == ($pod.metadata.labels // {})[.key]))
              | { name: .metadata.name,
                  headless: (.spec.clusterIP == "None"),
                  port: ([.spec.ports[] | select(.targetPort == $dp or .port == $dp)
                          | .port][0] // .spec.ports[0].port) } ]
            | sort_by(.headless) | .[0] as $svc
          | [$kind, $pod.metadata.namespace, ($svc.name // ""), ($svc.port // $dp),
             $pod.metadata.name, $ci] ]
        | unique_by([.[1], (if .[2] == "" then .[4] else .[2] end)])
        | .[] | @tsv' <<<"$pods"
}

# Set DB_HOST and DB_PORT for the last DB_* entry: DB_HOST_TEMPLATE when it
# gives a name that resolves, a bin/forward port otherwise.
# db_endpoint <service port>
db_endpoint()
{
    local port=$1 kind=${DB_KIND[-1]} host=$DB_HOST_TEMPLATE
    if [[ -n $host ]]; then
        host=${host//\{svc\}/${DB_SVC[-1]}}
        host=${host//\{ns\}/${DB_NS[-1]}}
        host=${host//\{cluster\}/${DB_SHORT[-1]}}
        host=${host//\{context\}/${DB_CTX[-1]}}
        if getent hosts "$host" >/dev/null; then
            DB_HOST+=("$host")
            DB_PORT+=("$port")
            return
        fi
    fi

    DB_HOST+=("$FORWARD_HOST")
    DB_PORT+=("${next_port[$kind]}")
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "${DB_CTX[-1]}" "${DB_NS[-1]}" "${DB_SVC[-1]}" \
        "${next_port[$kind]}" "$port" "$kind" >>"$WORK/forwards"
    next_port[$kind]=$((next_port[$kind] + 1))
}

# Set DB_USER and DB_PASS for the last DB_* entry, from its pod's env.
# db_credentials <pod> <container index>
db_credentials()
{
    local ctx=${DB_CTX[-1]} ns=${DB_NS[-1]} container user="" pass=""
    container=$(kc "$ctx" -n "$ns" get pod "$1" -o json | jq ".spec.containers[$2]")

    case ${DB_KIND[-1]} in
        mysql)
            user=root
            pass=$(pod_env "$container" MARIADB_ROOT_PASSWORD MYSQL_ROOT_PASSWORD)
            ;;
        postgres)
            user=$(pod_env "$container" POSTGRES_USER POSTGRESQL_USERNAME)
            user=${user:-postgres}
            pass=$(pod_env "$container" POSTGRES_PASSWORD POSTGRESQL_PASSWORD)
            ;;
        clickhouse)
            # ch-ui asks for credentials at login, it takes none here.
            ;;
    esac
    if [[ ${DB_KIND[-1]} != clickhouse && -z $pass ]]; then
        warn "$ctx: no password found in the env of $ns/$1 (*_FILE variables are not followed)"
    fi
    DB_USER+=("$user")
    DB_PASS+=("$pass")
}

# Print the value of the first <var> set in a container's env, the way the
# kubelet resolves it: env wins over envFrom, and a later envFrom source wins
# over an earlier one. Uses ns and ctx from the caller.
# pod_env <container json> <var>...
pod_env()
{
    local container=$1 var kind name key value
    shift
    for var in "$@"; do
        while IFS=$'\t' read -r kind name key; do
            # A source we may not read (RBAC) or that is gone is no value.
            value=""
            case $kind in
                value)     value=$(base64 --decode <<<"$name") ;;
                secret)    value=$(kc "$ctx" -n "$ns" get secret "$name" -o json 2>/dev/null |
                               jq -r --arg k "$key" '.data[$k] // empty | @base64d') || true ;;
                configmap) value=$(kc "$ctx" -n "$ns" get configmap "$name" -o json 2>/dev/null |
                               jq -r --arg k "$key" '.data[$k] // empty') || true ;;
            esac
            if [[ -n $value ]]; then
                printf '%s' "$value"
                return
            fi
        done < <(jq -r --arg v "$var" '
            ([.env[]? | select(.name == $v)] | last) as $e
            | if $e then
                if $e.value != null then ["value", ($e.value | @base64), ""]
                elif $e.valueFrom.secretKeyRef then
                    ["secret", $e.valueFrom.secretKeyRef.name, $e.valueFrom.secretKeyRef.key]
                elif $e.valueFrom.configMapKeyRef then
                    ["configmap", $e.valueFrom.configMapKeyRef.name, $e.valueFrom.configMapKeyRef.key]
                else empty end
              else
                [.envFrom[]? | (.prefix // "") as $p | select($v | startswith($p))
                 | if .secretRef then ["secret", .secretRef.name, ($v | ltrimstr($p))]
                   elif .configMapRef then ["configmap", .configMapRef.name, ($v | ltrimstr($p))]
                   else empty end]
                | reverse[]
              end
            | @tsv' <<<"$container")
    done
}

# db_indexes <kind> -- the DB_* indexes of that kind
db_indexes()
{
    local i
    for i in "${!DB_KIND[@]}"; do
        [[ ${DB_KIND[i]} == "$1" ]] && echo "$i"
    done
    return 0
}

# pgAdmin cannot import passwords from servers.json, so they go in a pgpass
# beside it. Both come from the same list, so they cannot drift.
gen_pgadmin()
{
    echo "pgadmin: one server per postgres"

    # pgAdmin creates this login once, with its config DB: a password picked
    # later would not match. Take over the one an earlier run generated.
    ensure_setting PGADMIN_PASSWORD \
        "$(sed -n 's/^PGADMIN_DEFAULT_PASSWORD=//p' "$PGADMIN_DIR/secrets.env" 2>/dev/null || true)"
    {
        printf 'PGADMIN_DEFAULT_EMAIL=%s\n' "$PGADMIN_EMAIL"
        printf 'PGADMIN_DEFAULT_PASSWORD=%s\n' "$PGADMIN_PASSWORD"
    } | write_out "$PGADMIN_DIR/secrets.env" 600

    local i n=0 servers='{}' pgpass=""
    for i in $(db_indexes postgres); do
        n=$((n + 1))
        servers=$(jq --arg id "$n" --arg name "${DB_SVC[i]} (${DB_SHORT[i]})" \
            --arg group "$PGADMIN_GROUP" --arg host "${DB_HOST[i]}" \
            --argjson port "${DB_PORT[i]}" --arg user "${DB_USER[i]}" '
            .[$id] = {
              Name: $name, Group: $group, Host: $host, Port: $port,
              MaintenanceDB: "postgres", Username: $user, SSLMode: "prefer",
              ConnectionParameters: {sslmode: "prefer", connect_timeout: 10, passfile: "/.pgpass"}
            }' <<<"$servers")
        pgpass+=$(printf '%s:%s:*:%s:%s' "${DB_HOST[i]}" "${DB_PORT[i]}" \
            "$(escape_pgpass <<<"${DB_USER[i]}")" "$(escape_pgpass <<<"${DB_PASS[i]}")")
        pgpass+=$'\n'
    done
    if (( ! n )); then
        echo "  no postgres found, left alone"
        return
    fi

    jq '{Servers: .}' <<<"$servers" | write_out "$PGADMIN_DIR/servers.json" 644

    # pgAdmin runs as uid 5050 and does not own these files: it reads pgpass
    # through gid 0 (see PERSIST_DIRS). The entrypoint copies it in and chmods
    # the copy to 600.
    { echo '# hostname:port:database:username:password'; printf '%s' "$pgpass"; } |
        write_out "$PGADMIN_DIR/pgpass" 640
}

# Make sure the setting <var> has a value: <fallback> if it is empty, else a
# random one. Either is saved to .env, so the next run uses it too, and so is
# that run's answer to "what is the password?".
# ensure_setting <var> [<fallback>]
ensure_setting()
{
    local var=$1 value=${2:-}
    [[ -n ${!var} ]] && return 0
    [[ -n $value ]] || value=$(random_secret)
    printf -v "$var" '%s' "$value"

    [[ -e .env ]] || cp -- .env.dist .env
    # Fill in the first empty or commented-out line for it, else append one.
    awk -v k="$var" -v v="$value" '
        !done && ($0 ~ "^" k "=$" || $0 ~ "^#[[:space:]]*" k "=") {
            print k "=" v; done = 1; next
        }
        { print }
        END { if (!done) print k "=" v }' .env >"$WORK/env"
    cat "$WORK/env" >.env
    chmod 600 .env
    echo "  .env: $var saved"
}

# Give each <var> in the env file <file> a random value, unless it already has
# one: changing JWT_SECRET logs everyone out, changing an encryption key loses
# what it encrypted. A missing <file> starts from its .persist.dist copy.
# ensure_secrets <file> <var>...
ensure_secrets()
{
    local file=$1 dist=${1/\/.persist\//\/.persist.dist\/} var value
    shift
    if [[ ! -e $file ]]; then
        mkdir -p "$(dirname "$file")"
        if [[ -f $dist ]]; then cp -- "$dist" "$file"; else : >"$file"; fi
    fi
    chmod 600 "$file"

    for var in "$@"; do
        grep -q "^$var=." "$file" && continue
        value=$(random_secret)
        if grep -q "^$var=" "$file"; then
            sed -i "s|^$var=\$|$var=$value|" "$file"
        else
            printf '%s=%s\n' "$var" "$value" >>"$file"
        fi
        echo "  $file: new $var"
    done
}

# pgpass treats ':' and '\' as special, they have to be backslash escaped
escape_pgpass() { sed -e 's/\\/\\\\/g' -e 's/:/\\:/g'; }

# Every mariadb/mysql in one phpMyAdmin, picked from its server list. The
# image takes the servers as comma-separated lists, but only one login for all
# of them: config.user.inc.php gives each its own, from PMA_USER_<n> and
# PMA_PASSWORD_<n>.
gen_pma()
{
    echo "pma: one server per mariadb/mysql"

    local i n=0 hosts=() ports=() names=() logins=""
    for i in $(db_indexes mysql); do
        n=$((n + 1))
        hosts+=("${DB_HOST[i]}")
        ports+=("${DB_PORT[i]}")
        names+=("${DB_SVC[i]} (${DB_SHORT[i]})")
        logins+=$(printf 'PMA_USER_%d=%s\nPMA_PASSWORD_%d=%s' \
            "$n" "${DB_USER[i]}" "$n" "${DB_PASS[i]}")
        logins+=$'\n'
    done

    # The per-server files and .env link earlier runs made.
    prune_env_files pma
    if (( ! n )); then
        echo "  no mariadb/mysql found, left alone"
        return
    fi

    {
        echo "$MARKER -- do not edit."
        (IFS=,; printf 'PMA_HOSTS=%s\nPMA_PORTS=%s\nPMA_VERBOSES=%s\n' \
            "${hosts[*]}" "${ports[*]}" "${names[*]}")
        printf '%s' "$logins"
    } | write_out pma/.env 600
}

# One env file per clickhouse; ch-ui reads whichever .env points at. Its
# APP_SECRET_KEY is kept across runs: changing it logs everyone out.
gen_chui()
{
    echo "chui: one env file per clickhouse"

    local i file key files=()
    for i in $(db_indexes clickhouse); do
        file=ch-ui/.env.${DB_SHORT[i]}.${DB_SVC[i]}
        files+=("$file")
        key=$(sed -n 's/^APP_SECRET_KEY=//p' "$file" 2>/dev/null || true)
        {
            echo "$MARKER -- do not edit."
            printf 'APP_SECRET_KEY=%s\n' "${key:-$(random_secret)}"
            printf 'CLICKHOUSE_URL=http://%s:%s\n' "${DB_HOST[i]}" "${DB_PORT[i]}"
            printf 'CONNECTION_NAME=%s (%s)\n' "${DB_SVC[i]}" "${DB_SHORT[i]}"
        } | write_out "$file" 600
    done
    select_env ch-ui "${files[@]}"
}

# Drop the generated <dir>/.env.* files that are not <keep>, i.e. whose
# database is gone. A dangling .env link goes with them.
# prune_env_files <dir> <keep>...
prune_env_files()
{
    local dir=$1 f
    shift
    for f in "$dir"/.env.*; do
        [[ -f $f ]] || continue
        has_section "$f" "$@" && continue
        if head -n1 "$f" | grep -qF "$MARKER"; then
            rm -f -- "$f"
            echo "  removed $f"
        fi
    done
    if [[ -L $dir/.env && ! -e $dir/.env ]]; then
        rm -f -- "$dir/.env"
    fi
}

# Drop generated env files nobody wrote this run, and point <dir>/.env at the
# first one written unless it already points at a file.
# select_env <dir> <file written>...
select_env()
{
    local dir=$1
    shift
    prune_env_files "$dir" "$@"

    if (( ! $# )); then
        echo "  none found, left alone"
        return
    fi
    # An untouched copy of .env.dist is only init's placeholder.
    if [[ ! -e $dir/.env ]] || { [[ ! -L $dir/.env ]] && cmp -s "$dir/.env" "$dir/.env.dist"; }; then
        ln -sfn -- "$(basename "$1")" "$dir/.env"
    fi
    echo "  $dir/.env -> $(readlink "$dir/.env" 2>/dev/null || echo "(not a link)")"
}

# Give every *.dist a real copy, never overwriting one.
gen_init()
{
    echo "init: filling in from *.dist"

    local dist target dir
    while IFS= read -r dist; do
        target=${dist%.dist}
        if [[ -d $dist ]]; then
            (cd "$dist" && find . -type f) | while IFS= read -r f; do
                [[ -e $target/$f || -L $target/$f ]] && continue
                mkdir -p "$(dirname "$target/$f")"
                cp -p -- "$dist/$f" "$target/$f"
                echo "  copied ${target#./}/${f#./}"
            done
        elif [[ ! -e $target && ! -L $target ]]; then
            cp -p -- "$dist" "$target"
            echo "  copied ${target#./}"
        fi
    done < <(find . -path ./.git -prune -o -name '*.dist' -print | sort)

    for dir in "${PERSIST_DIRS[@]}"; do
        [[ -d $dir ]] || { mkdir -p "$dir"; echo "  created $dir/"; }
        chmod 770 "$dir"
    done
}

# restart_stacks <section>...
restart_stacks()
{
    local section stacks=() stack
    for section in "$@"; do
        case $section in
            kube)    stacks+=(policy-reporter radar trivy-operator-dashboard velero-ui) ;;
            kite)    stacks+=(kite) ;;
            pgadmin) stacks+=(pgadmin) ;;
            pma)     stacks+=(pma) ;;
            chui)    stacks+=(ch-ui) ;;
        esac
    done
    (( ${#stacks[@]} )) || return 0

    for stack in $(printf '%s\n' "${stacks[@]}" | sort -u); do
        if [[ -z $(cd "$stack" && docker compose ps -q 2>/dev/null) ]]; then
            echo "  $stack: not running, left alone"
            continue
        fi
        if [[ $stack == pgadmin ]]; then
            # pgAdmin copies PGPASS_FILE only when it initialises its config
            # DB, and /var/lib/pgadmin is an image-declared volume that
            # --force-recreate carries over. Only a new container gets the new
            # passwords.
            ( cd "$stack" && docker compose down && docker compose up -d )
        else
            ( cd "$stack" && docker compose up -d --force-recreate )
        fi
        echo "  $stack: recreated"
    done
}

main "$@"
